{
    "name": "QMK Dev Container",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "root",
    "features": {
        "ghcr.io/devcontainers/features/git:1": {}
    },
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh"
            },
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "xaver.clang-format"
            ]
        }
    },
    "postStartCommand": "qmk hello"
}
